{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Xibalba Shield",
  "version": "0.1.0",
  "identifier": "com.xibalba.shield.device",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5174",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      { "label": "main", "title": "Xibalba Shield", "width": 980, "height": 700, "minWidth": 480, "minHeight": 520 }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/icon.png"]
  }
}
