<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.xibalba.shield</string>
    <key>ProgramArguments</key>
    <array>
        <string>/usr/local/bin/xibalba-shield-run</string>
    </array>
    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <dict>
        <key>SuccessfulExit</key>
        <false/>
    </dict>
    <key>StandardOutPath</key>
    <string>/var/log/xibalba-shield/stdout.log</string>
    <key>StandardErrorPath</key>
    <string>/var/log/xibalba-shield/stderr.log</string>
    <key>WorkingDirectory</key>
    <string>/Library/Application Support/xibalba-shield</string>
    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin:/opt/homebrew/bin</string>
        <key>SHIELD_DATA_DIR</key>
        <string>/var/log/xibalba-shield</string>
        <key>SHIELD_CONFIG_DIR</key>
        <string>/etc/xibalba-shield</string>
    </dict>
    <key>HardResourceLimits</key>
    <dict>
        <key>NumberOfFiles</key>
        <integer>2048</integer>
    </dict>
</dict>
</plist>
