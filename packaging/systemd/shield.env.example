SHIELD_SENSOR=process-exec
# Local-only mode for pilots without a live Integrity stack:
# SHIELD_EXPORTER_ARGS=--no-exporter
SHIELD_EXPORTER_ARGS=
# Uncomment to have Shield itself start/health-probe/restart OPA as a supervised child
# process instead of assuming an already-running external sidecar at --opa-url. Must
# include the full --opa-command flag (nargs="+", so it cannot be left bare when unset --
# same reason SHIELD_EXPORTER_ARGS carries its whole flag rather than just a value). The
# referenced binary must be installed on this host before the unit starts -- there is no
# install step for it in this package. See docs/runbooks/linux-agent.md.
# SHIELD_OPA_ARGS=--opa-command /usr/local/bin/opa run --server --addr localhost:8181
SHIELD_OPA_ARGS=
