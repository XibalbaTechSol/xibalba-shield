SHIELD_SENSOR=process-exec
SHIELD_OPA_URL=http://127.0.0.1:8181
# Optional split-privilege mode: enable xibalba-shield-ebpf-helper.service
# and set this socket so the main service never loads BCC itself.
# SHIELD_PRIVILEGED_SOCKET=/run/xibalba-shield/ebpf.sock
SHIELD_DEVICE_ID=
SHIELD_DEV_DISABLE_AUTH=false
SHIELD_TENANT_ID=
# Required for signed CORE policy delivery. Set this through the deployment secret store;
# a file: path is preferred so the public key is not duplicated in unit arguments.
# XIBALBA_ORACLE_POLICY_PUBLIC_KEY=file:/etc/xibalba-shield/secrets/oracle-policy-issuer.pub
# Keep the packaged virtualenv ahead of distro site-packages so its async
# dependencies (notably typing_extensions) are used while retaining BCC.
PYTHONPATH=/opt/xibalba-shield/venv/lib/python3.12/site-packages:/usr/lib/python3/dist-packages
# Local-only mode for pilots without a live Integrity stack:
# SHIELD_EXPORTER_ARGS=--no-exporter
SHIELD_EXPORTER_ARGS=
# Uncomment to have Shield itself start/health-probe/restart OPA as a supervised child
# process instead of assuming an already-running external sidecar at --opa-url. Must
# include the full --opa-command flag (nargs="+", so it cannot be left bare when unset --
# same reason SHIELD_EXPORTER_ARGS carries its whole flag rather than just a value). The
# referenced binary must be installed on this host before the unit starts -- there is no
# install step for it in this package. See docs/runbooks/linux-agent.md.
# SHIELD_OPA_ARGS=--opa-command /usr/local/bin/opa run --server --addr localhost:8181
SHIELD_OPA_ARGS=
# Gated responders remain disabled unless both their explicit flag and every
# device-bound proof in this fresh artifact pass.
# SHIELD_RESPONDER_ARGS=--responder-readiness /etc/xibalba-shield/responder-readiness.json --enable-kill-process --enable-freeze-cgroup --enable-block-flow
SHIELD_RESPONDER_ARGS=
# Backend TLS is configured in /etc/xibalba-shield/backend.env when the control
# plane is exposed beyond loopback. Set all three for mTLS; never use a self-signed
# certificate for an external deployment.
# SHIELD_BACKEND_TLS_CERT=/etc/xibalba-shield/tls/server.crt
# SHIELD_BACKEND_TLS_KEY=/etc/xibalba-shield/tls/server.key
# SHIELD_BACKEND_TLS_CLIENT_CA=/etc/xibalba-shield/tls/client-ca.crt
# SHIELD_BACKEND_TLS_PORT=8443
# XIBALBA_AGENT_ID, XIBALBA_CORTEX_URL, XIBALBA_CORTEX_TOKEN, and
# XIBALBA_CORTEX_OUTBOX are required when cloud publication is enabled.
